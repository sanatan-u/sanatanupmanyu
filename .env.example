# Contact form (/api/contact) — delivered via Gmail SMTP using nodemailer.
#
# Gmail requires an App Password (not your login password).
# 1. Enable 2-Step Verification on the Google account.
# 2. Visit https://myaccount.google.com/apppasswords and generate a 16-char
#    password for "Mail". Paste it into SMTP_PASS below (spaces are OK).
#
# CONTACT_FROM must match SMTP_USER — Gmail rewrites or rejects mismatched
# senders. The visitor's email is set as Reply-To, so hitting "reply" works.
#
# If any of SMTP_HOST/SMTP_USER/SMTP_PASS are missing, the route logs the
# submission to the server console instead of sending — useful for dev.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
CONTACT_TO=sanatan.u@gmail.com
CONTACT_FROM=your.address@gmail.com

# Google Analytics 4 — Measurement ID (starts with "G-").
# Leave blank to disable analytics. Found at analytics.google.com →
# Admin → Data Streams → Web stream details.
NEXT_PUBLIC_GA_ID=
